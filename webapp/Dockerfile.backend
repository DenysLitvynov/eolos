# Fecha : 08/12/2025
# Descripción : Dockerfile para el backend.

# Usamos Python 3.12 slim para mantenerlo ligero
FROM python:3.12-slim

# Establecemos directorio de trabajo
WORKDIR /app

# Copiamos solo lo necesario: backend, requirements, alembic.ini, migrations
COPY requirements.txt .
COPY backend/ backend/
COPY alembic.ini .
COPY backend/migrations/ migrations/

# Instalamos dependencias (sin tests ni extras)
RUN pip install --no-cache-dir -r requirements.txt

# Exponemos puerto 8000 para Uvicorn
EXPOSE 8000

# Comando por defecto: Ejecuta Uvicorn con el app de FastAPI
CMD ["uvicorn", "backend.app:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
