<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:fitsSystemWindows="true"
    tools:context=".activities.QR_recompensa_activity">

    <include
        android:id="@+id/header_container"
        layout="@layout/header_logoyflecha"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp"
        app:layout_constraintTop_toBottomOf="@id/header_container"
        app:layout_constraintBottom_toTopOf="@id/menu_inferior">

        <TextView
            android:id="@+id/tv_nombre_recompensa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Canjear Recompensa"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/azul_profundo"
            android:fontFamily="@font/rethink_sans"
            android:textAlignment="center" />

        <TextView
            android:id="@+id/tv_instrucciones"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Muestra este código en el establecimiento"
            android:textSize="14sp"
            android:textColor="@color/azul_profundo"
            android:fontFamily="@font/rethink_sans"
            android:alpha="0.8" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/seccion_1"
            android:padding="25dp">

            <ImageView
                android:id="@+id/iv_codigo_qr"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:scaleType="fitCenter"
                android:src="@drawable/icono_qr" />
        </FrameLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_descargar"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/azul_profundo"
            android:fontFamily="@font/rethink_sans"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:text="Descargar QR"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:cornerRadius="12dp" />

    </LinearLayout>

    <include
        android:id="@+id/menu_inferior"
        layout="@layout/menu_navegacion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>