<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:id="@+id/root_dashboard"
    android:fitsSystemWindows="true">

    <!-- SCROLL DEL CONTENIDO -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_home"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/menu_inferior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <!-- TÍTULO + NOMBRE USUARIO -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bienvenido "
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/azul_profundo"
                    android:fontFamily="@font/rethink_sans" />

                <TextView
                    android:id="@+id/tv_nombre_usuario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/azul_profundo"
                    android:fontFamily="@font/rethink_sans" />
            </LinearLayout>

            <!-- CTA CARD - VER MAPA -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cta_card_mapa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:backgroundTint="#0D47A1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Contaminación en tiempo real"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        android:fontFamily="@font/rethink_sans" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Observa un mapa de calor de la calidad del aire en tu localización actual"
                        android:textSize="14sp"
                        android:textColor="@android:color/white"
                        android:fontFamily="@font/rethink_sans"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="12dp" />

                    <Button
                        android:id="@+id/btn_cta_mapa"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ver Mapa"
                        android:textColor="#0D47A1"
                        android:textSize="14sp"
                        android:textAllCaps="false"
                        android:fontFamily="@font/rethink_sans"
                        android:backgroundTint="@android:color/white"
                        style="@style/BotonPrincipal" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- DATOS DE TU ÚLTIMO TRAYECTO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Datos de tu último trayecto"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/azul_profundo"
                android:fontFamily="@font/rethink_sans"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <!-- TARJETA AQI PRINCIPAL -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_aqi_principal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                android:backgroundTint="@android:color/white"
                app:strokeColor="@color/azul_grisaceo"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Índice de Calidad del Aire (AQI)"
                        android:textSize="13sp"
                        android:textColor="@color/negro"
                        android:fontFamily="@font/rethink_sans" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_aqi_valor"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textSize="30sp"
                                android:textStyle="bold"
                                android:textColor="@color/azul_profundo"
                                android:fontFamily="@font/rethink_sans" />

                            <TextView
                                android:id="@+id/tv_aqi_estado"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textSize="14sp"
                                android:textColor="@color/negro"
                                android:fontFamily="@font/rethink_sans"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/img_aqi_icon"
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:src="@drawable/feliz"
                            android:scaleType="fitCenter"
                            android:contentDescription="Estado AQI" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_aqi_descripcion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="--"
                        android:textSize="13sp"
                        android:textColor="@color/negro"
                        android:fontFamily="@font/rethink_sans" />

                    <TextView
                        android:id="@+id/tv_aqi_maximo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="--"
                        android:textSize="12sp"
                        android:textColor="@color/negro"
                        android:fontFamily="@font/rethink_sans" />

                    <TextView
                        android:id="@+id/tv_aqi_fechas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="--"
                        android:textSize="11sp"
                        android:textColor="#999999"
                        android:fontFamily="@font/rethink_sans" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- TRAYECTO ACTUAL -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_trayecto_actual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                android:backgroundTint="@android:color/white"
                app:strokeColor="@color/azul_grisaceo"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Trayecto actual"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/negro"
                        android:fontFamily="@font/rethink_sans" />

                    <TextView
                        android:id="@+id/tv_distancia_actual"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="0.0 m"
                        android:textSize="48sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:textColor="@color/azul_profundo"
                        android:gravity="center_horizontal" />

                    <TextView
                        android:id="@+id/tv_estado_conexion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Desconectado"
                        android:textSize="12sp"
                        android:textColor="#999999"
                        android:fontFamily="@font/rethink_sans"
                        android:gravity="center_horizontal" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SELECTOR TRAYECTOS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Selecciona un trayecto"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/azul_profundo"
                    android:fontFamily="@font/rethink_sans"
                    android:layout_marginBottom="8dp" />

                <Spinner
                    android:id="@+id/spinner_trayectos"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@android:drawable/btn_dropdown"
                    android:padding="12dp" />
            </LinearLayout>

            <!-- GRÁFICO MEDICIONES -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Niveles del Aire"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/azul_profundo"
                android:fontFamily="@font/rethink_sans"
                android:layout_marginBottom="8dp" />

            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/chart_mediciones"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginBottom="16dp" />

            <!-- RESUMEN -->
            <LinearLayout
                android:id="@+id/container_resumen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp"
                android:gravity="center" />

            <!-- ESCALA AIRE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Escala de Nivel del Aire"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/azul_profundo"
                android:fontFamily="@font/rethink_sans"
                android:layout_marginBottom="8dp" />

            <!-- Buena -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/circulo_verde" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="Buena"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/negro"
                        android:fontFamily="@font/rethink_sans" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0–49"
                        android:textSize="11sp"
                        android:textColor="@color/negro"
                        android:fontFamily="@font/rethink_sans" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Buena para la mayoría de personas."
                    android:textSize="11sp"
                    android:textColor="@color/negro"
                    android:fontFamily="@font/rethink_sans" />
            </LinearLayout>

            <!-- Mala -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/circulo_amarillo" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="Mala"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/negro"
                        android:fontFamily="@font/rethink_sans" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="50–99"
                        android:textSize="11sp"
                        android:textColor="@color/negro"
                        android:fontFamily="@font/rethink_sans" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Poco saludable para grupos sensibles."
                    android:textSize="11sp"
                    android:textColor="@color/negro"
                    android:fontFamily="@font/rethink_sans" />
            </LinearLayout>

            <!-- Poco saludable -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/circulo_rojo" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="Poco saludable"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/negro"
                        android:fontFamily="@font/rethink_sans" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+100"
                        android:textSize="11sp"
                        android:textColor="@color/negro"
                        android:fontFamily="@font/rethink_sans" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Efectos sobre la salud en grupos sensibles."
                    android:textSize="11sp"
                    android:textColor="@color/negro"
                    android:fontFamily="@font/rethink_sans" />
            </LinearLayout>

            <!-- CTA CARD - VER RECOMPENSAS -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cta_card_recompensas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:backgroundTint="#2E7D32">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Impacto positivo"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        android:fontFamily="@font/rethink_sans" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Comprueba tus recompensas y tu impacto positivo en el medio ambiente"
                        android:textSize="14sp"
                        android:textColor="@android:color/white"
                        android:fontFamily="@font/rethink_sans"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="12dp" />

                    <Button
                        android:id="@+id/btn_cta_recompensas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ver Recompensas"
                        android:textColor="#2E7D32"
                        android:textSize="14sp"
                        android:textAllCaps="false"
                        android:fontFamily="@font/rethink_sans"
                        android:backgroundTint="@android:color/white"
                        style="@style/BotonPrincipal" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- MENÚ INFERIOR FIJO -->
    <include
        android:id="@+id/menu_inferior"
        layout="@layout/menu_navegacion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
