<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <!-- HEADER REUTILIZABLE -->
    <include
        android:id="@+id/header_container"
        layout="@layout/header_logoyflecha"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- TÍTULO -->
    <TextView
        android:id="@+id/tv_titulo_terminos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Términos y condiciones"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/azul_profundo"
        android:fontFamily="@font/rethink_sans"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/header_container"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- CONTENIDO SCROLLEABLE -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_terminos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/tv_titulo_terminos"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/menu_inferior">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/seccion_1"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_texto_terminos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/negro"
                android:textSize="13sp"
                android:fontFamily="@font/rethink_sans"
                android:lineSpacingExtra="2dp"
                android:text="@string/texto_terminos_condiciones"/>
        </FrameLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- MENÚ INFERIOR -->
    <include
        android:id="@+id/menu_inferior"
        layout="@layout/menu_navegacion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>